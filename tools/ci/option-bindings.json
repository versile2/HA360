{
  "keys": [
    "log_level",
    "driving_week_start",
    "driving_speeding_mph",
    "retention_fix_days",
    "demo_mode",
    "allow_demo_param"
  ],
  "bindings": {
    "log_level": { "path": "Logging:LogLevel:Default", "default": "Information" },
    "driving_week_start": { "path": "Driving:WeekStart", "default": "monday" },
    "driving_speeding_mph": { "path": "Driving:SpeedingMps", "default": 80, "factor": 0.44704 },
    "retention_fix_days": { "path": "Retention:FixDays", "default": 120 },
    "demo_mode": { "path": "Demo:Mode", "default": false },
    "allow_demo_param": { "path": "Demo:AllowParam", "default": false }
  }
}
