@page "/"
@implements IAsyncDisposable
@using Microsoft.JSInterop
@using Realm.Demo
@using Realm.Domain
@using Realm.Web.Components
@using Realm.Web.Components.Map
@using Realm.Web.Components.Shell
@using Realm.Web.Components.Sheet
@using Realm.Web.Formatting
@using Realm.Web.Layout
@using Realm.Web.Map
@using Realm.Web.Shell
@using Realm.Web.Sheet
@using Realm.Web.State
@inject IConfiguration Configuration
@inject IJSRuntime JS
@inject ILogger<LocationPage> Logger
@inject DevicePrefs Prefs
@inject ISnackbar Snackbar
@inject RealmUiState Ui
@inject HistorySync History

@* The Location screen (01 section 3): the map fills the canvas, the sheet (a bottom sheet, or the left panel from 840 x 560) draws over it, and the right button
   stack floats above the sheet. The session comes from RealmShell's cascading value and its snapshot is read at render: the page re-renders on
   IRealmSession.Changed and passes the new immutable lists down, so MapView's reference check sends only what changed. The instant is the session's own
   clock (no wall clock), and a MinuteTicker re-renders on the minute so that time-based strings and the 24 hour rule of the handle summary stay current.

   The layout is unknown until the browser has reported its window (ShellInterop, after the first render: prerendering has no window). Until then only a
   placeholder reserving the Peek band is drawn; the map and the sheet start together with the real layout, so the map's first default camera already uses the
   right padding.

   The sheet's state (section, selection, size) is the circuit's RealmUiState (03 section 3.6, scoped, so it outlives this page and a trip to Driving finds the selection where it was,
   R2-03) and every change goes through its reducer: a row, a pin, a zone, a bubble, the empty map, the handle, the header, the back arrow and the segments raise events and the sheet shows
   RealmUiState.Body (list, selection header or detail, D45). The map's Selection is read from it, so nothing else holds a selection; a tap on the entity that is already selected changes
   nothing there and MapView flies to it again by itself (D89). A tap on the selection header and a tap on the handle are the same event (D46). HistorySync keeps the browser history at the
   state's depth (03 section 3.7): the Android Back and Esc come back here as reductions of the same state, and the page only re-renders. The floating pill of the hidden Expanded panel
   (01 section 3.6) is drawn here when the layout says the panel is hidden, which nothing sets yet. *@
<section class="realm-location">
    @if (_viewport is { } viewport)
    {
        var members = Snapshot.Members;
        var vehicles = Snapshot.Vehicles;
        var places = Snapshot.Places;
        var summary = HandleSummaryFormatter.Format(Ui.Section, members, vehicles, places, Session.Time.GetUtcNow());
        var panel = _mode == LayoutMode.Expanded;
        var pill = panel && Ui.Layout.PanelHidden && Ui.Selection is { } selected
            ? SelectionHeaderFormatter.For(selected, members, vehicles, places, RowFacts.Create(members, places, Ui.MeId, Session.Time.GetUtcNow(), Session.Zone))
            : null;

        <MapView Members="@members"
                 Vehicles="@vehicles"
                 Places="@places"
                 Now="@Session.Time.GetUtcNow()"
                 StyleId="@StyleId"
                 ShowZones="@Prefs.ShowZones"
                 Options="@_mapOptions"
                 OnStyleFailed="OnStyleFailedAsync"
                 Layout="@_mapLayout"
                 ReducedMotion="@viewport.ReducedMotion"
                 TestHooks="@TestHooks"
                 MeId="@Ui.MeId"
                 Selection="@Ui.Selection"
                 RestoreCamera="@_restoreCamera"
                 OnPinTap="OnPinTapAsync"
                 OnBubbleTap="OnBubbleTapAsync"
                 OnMapTap="OnMapTapAsync"
                 OnCameraChanged="OnCameraChangedAsync"
                 OnFollowEnded="OnFollowEndedAsync" />

        <RealmSheetHost Mode="@_mode"
                        Size="@Ui.SheetSize"
                        ViewportWidth="@viewport.Width"
                        Summary="@summary"
                        OnSizeChanged="OnSizeChangedAsync"
                        OnToggle="OnToggleAsync">
            <SheetContent Members="@members"
                          Vehicles="@vehicles"
                          Places="@places"
                          Section="@Ui.Section"
                          Body="@Ui.Body"
                          MeId="@Ui.MeId"
                          FocusDetail="@_focusDetail"
                          OnSection="OnSectionAsync"
                          OnSelect="OnSelectAsync"
                          OnToggle="OnToggleAsync"
                          OnClear="OnClearAsync"
                          OnBack="OnBackAsync"
                          OnHereNow="OnHereNowAsync"
                          Summary="@summary"
                          ShowSummary="@panel" />
        </RealmSheetHost>

        @if (pill is not null)
        {
            <SheetSelectionHeader Header="pill" Pill="true" OnClear="OnClearAsync" />
        }

        <RightButtonStack Hidden="@(!_mapLayout.StackVisible)"
                          Panel="@panel"
                          MapStyleName="@StyleName"
                          StyleId="@StyleId"
                          ShowZones="@Prefs.ShowZones"
                          OnStyleChosen="OnStyleChosenAsync"
                          OnShowZonesChanged="OnShowZonesChangedAsync" />
    }
    else
    {
        <div class="realm-peek-placeholder">
            <p class="realm-summoning" role="status">@HandleSummaryFormatter.Loading</p>
        </div>
    }
</section>

@code {
    private ShellInterop? _shell;
    private MinuteTicker? _ticker;
    private ViewportInfo? _viewport;
    private LayoutMode _mode = LayoutMode.Unknown;
    private LayoutOverride _layoutOverride;
    private bool _focusDetail;
    private CameraState? _restoreCamera;
    private IAsyncDisposable? _history;
    private MapLayout _mapLayout = MapLayout.Compact;
    private bool _started;
    private bool _disposed;

    // S10a: the device preferences (01 section 7.9). A style chosen in the page, else the Demo URL's, else the stored one, else Night; the radius reaches the map as its default-view option.
    private string? _chosenStyle;
    private MapPayloadOptions _mapOptions = MapPayloadOptions.Default;
    private bool _prefsSubscribed;

    /// <summary>The circuit's session, cascaded by <c>RealmShell</c>.</summary>
    [CascadingParameter]
    public IRealmSession Session { get; set; } = default!;

    /// <summary>The Appendix-B overrides of this circuit (<c>style</c>, <c>sheet</c> and <c>layout</c> here), cascaded by <c>RealmShell</c>.</summary>
    [CascadingParameter]
    public DemoUiOverrides? Overrides { get; set; }

    /// <summary>The viewer's member slug, resolved in static SSR and cascaded by <c>Routes</c> (03 section 5.5); null when there is none. Never a Home Assistant user id.</summary>
    [CascadingParameter(Name = Routes.ViewerMemberIdName)]
    public string? ViewerMemberId { get; set; }

    private RealmSnapshot Snapshot => Session.Current;

    // A Demo session (Demo mode, or a Live circuit that opened with demo=1 while it is allowed) installs window.__realm, as does
    // the hosting switch Realm:TestHooks (03 section 4.10). The style defaults to Night; Demo and CI ask for demo-offline with ?style=.
    private bool TestHooks => Session is DemoRealmSession || (bool.TryParse(Configuration["Realm:TestHooks"], out var on) && on);

    private string StyleId => _chosenStyle ?? Overrides?.Style ?? Prefs.MapStyle;

    // The layers button's accessible name (01 section 10.3); the hidden demo-offline style reads as "Demo".
    private string StyleName => NameOf(StyleId);

    private static string NameOf(string styleId) =>
        styleId switch
        {
            MapStyleIds.Day => "Day",
            MapStyleIds.Streets => "Streets",
            MapStyleIds.Satellite => "Satellite",
            MapStyleIds.DemoOffline => "Demo",
            _ => "Night",
        };

    // Prerendering runs this twice (the prerender scope, then the circuit); each has its own RealmUiState. The state outlives this page (it is the circuit's), so what belongs to the
    // first start of the circuit happens once: "me" from SSR is set when nobody set it, and the Demo sheet override applies only at the first start, not again on the way back from Driving,
    // when the sheet is the person's own.
    protected override void OnInitialized()
    {
        _layoutOverride = LayoutResolver.ParseOverride(Overrides?.Layout ?? Prefs.Layout);
        if (Ui.MeId is null && ViewerMemberId is not null)
        {
            Ui.MeId = ViewerMemberId;
        }

        if (Ui.TryBeginStartup() && Overrides?.Sheet == "80")
        {
            Ui.Apply(new SheetEvent.HandleSet(SheetSize.Tall));
        }

        // R1-12: the camera the person left, when they are back within ten minutes; null runs the default camera.
        _restoreCamera = Ui.CameraToRestore(Session.Time.GetUtcNow());
    }

    // The circuit exists from the first render on: only now can the page subscribe, tick and talk to the browser.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _started)
        {
            return;
        }

        _started = true;
        Session.Changed += OnSessionChanged;
        Ui.Changed += OnUiChanged;
        _ticker = new MinuteTicker(Session.Time);
        _ticker.Tick += OnMinute;
        _ticker.Start();

        try
        {
            // The stored preferences first (S10a): the first layout and the map's first style are the person's own. A browser that refuses storage leaves the defaults.
            await Prefs.EnsureLoadedAsync();
            Prefs.Changed += OnPrefChanged;
            _prefsSubscribed = true;
            _layoutOverride = LayoutResolver.ParseOverride(Overrides?.Layout ?? Prefs.Layout);
            _mapOptions = MapPayloadOptions.Default with { DefaultViewRadiusKm = Prefs.ViewRadiusKm };

            _shell = await ShellInterop.CreateAsync(JS, new ShellCallbacks(OnViewportAsync));
            var info = await _shell.InitAsync();
            if (info is not null && !_disposed)
            {
                await ApplyViewportAsync(info.Viewport);
                await _shell.ObserveSheetAsync(ShellInterop.SheetSelector);
            }
        }
        catch (Exception exception) when (exception is JSException or JSDisconnectedException or OperationCanceledException)
        {
            // Without the viewport the placeholder stays; the page never takes the circuit down with it.
            Logger.LogError(exception, "The Location page could not start its browser shell.");
        }

        // After the shell, so the map is not kept waiting for the history; the viewport and the state are known by now.
        if (!_disposed)
        {
            await AttachHistoryAsync();
        }
    }

    // The Android Back and Esc arrive here as changes of the state (HistorySync reduces it off the renderer's context), so the page renders them; so does every other change of it.
    private void OnUiChanged()
    {
        if (_disposed)
        {
            return;
        }

        _ = InvokeAsync(() =>
        {
            RefreshMapLayout();
            StateHasChanged();
        });
    }

    // The history tokens (03 section 3.7): from here the browser history follows the depth of the state. A browser or circuit that refuses leaves the page without them; it still works.
    private async Task AttachHistoryAsync()
    {
        try
        {
            var lease = await HistoryInterop.AttachAsync(History, JS, HistorySurface.Location);
            if (_disposed)
            {
                await lease.DisposeAsync();
                return;
            }

            _history = lease;
        }
        catch (Exception exception) when (exception is JSException or JSDisconnectedException or OperationCanceledException)
        {
            Logger.LogWarning(exception, "The Location page could not attach the browser history.");
        }
    }

    // A resize, a rotation or a fold, debounced by the script: the callback arrives off the renderer's context.
    private Task OnViewportAsync(ViewportInfo viewport) => _disposed ? Task.CompletedTask : InvokeAsync(() => ApplyViewportAsync(viewport));

    private async Task ApplyViewportAsync(ViewportInfo viewport)
    {
        var mode = LayoutResolver.Resolve(viewport.Width, viewport.Height, _layoutOverride);
        if (mode != _mode && _shell is not null)
        {
            // The attribute first: the script reads it to decide whether a tall sheet hides the right stack, and the panel never does.
            await _shell.SetLayoutAttrAsync(mode);
        }

        _viewport = viewport;
        _mode = mode;
        Ui.Layout = new LayoutSnapshot(mode, PanelHidden: false, viewport.Width, viewport.Height, viewport.Safe);
        RefreshMapLayout();
        StateHasChanged();
    }

    // What the layout contributes to the map padding (01 section 3.4.3): the mode, the safe insets, and whether the right stack takes room (it does not at Tall).
    private void RefreshMapLayout() =>
        _mapLayout = new MapLayout(
            _mode == LayoutMode.Expanded ? MapLayoutMode.Expanded : MapLayoutMode.Compact,
            PanelHidden: false,
            StackVisible: !(_mode == LayoutMode.Compact && Ui.SheetSize == SheetSize.Tall),
            _viewport?.Safe ?? new Padding(0, 0, 0, 0));

    // Every sheet event takes the one path of SheetDispatch (the reducer, the Follow mirror, the focus rule; 01 section 5.7). The focus moves to the detail's back button only when the user just
    // opened the detail with the handle or the header (01 section 10.2).
    private Task ApplyAsync(SheetEvent sheetEvent)
    {
        _focusDetail = SheetDispatch.Apply(Ui, sheetEvent, Snapshot.Members);
        RefreshMapLayout();
        return Task.CompletedTask;
    }

    // A tap or a key on the handle asked for a size: the reducer decides (the panel has none).
    private Task OnSizeChangedAsync(SheetSize size) => ApplyAsync(new SheetEvent.HandleSet(size));

    // The tap on the selection header (D46) is the handle's own event: Peek to 80 percent, the selection kept, the header becomes the detail.
    private Task OnToggleAsync() => ApplyAsync(new SheetEvent.HandleToggle());

    private Task OnSectionAsync(Section section) => ApplyAsync(new SheetEvent.SegmentTap(section));

    private Task OnSelectAsync(EntityRef entity) => ApplyAsync(new SheetEvent.RowTap(entity));

    private Task OnHereNowAsync(string memberId) => ApplyAsync(new SheetEvent.HereNowTap(memberId));

    private Task OnClearAsync() => ApplyAsync(new SheetEvent.ClearTap());

    // A member pin, a vehicle pin or a zone was tapped (D45, 01 section 4.13): the same reducer as a row. The entity that is already selected changes nothing (MapView flies to it again).
    private Task OnPinTapAsync(EntityRef entity) => ApplyAsync(new SheetEvent.PinTap(entity));

    // The empty map was tapped: at 80 percent the sheet collapses with the selection kept, at Peek the selection clears, in the panel it always clears (01 section 4.13).
    private Task OnMapTapAsync() => ApplyAsync(new SheetEvent.MapTap());

    // A camera move settled: kept for the way back from Driving (R1-12). Nothing renders it, so nothing re-renders.
    private Task OnCameraChangedAsync(CameraState camera)
    {
        Ui.RecordCamera(camera, Session.Time.GetUtcNow());
        return Task.CompletedTask;
    }

    // The script ended Follow (a gesture, a bubble tap, a recentre, or the member stopped driving).
    private Task OnFollowEndedAsync()
    {
        Ui.FollowMemberId = null;
        return Task.CompletedTask;
    }

    // An edge bubble was tapped (D45, D84): the same reducer as a row, the handle and the header. One member id selects that member exactly like a pin tap (the selection is set and the
    // sheet is left at Peek); a cluster (two or more ids) changes nothing here, its camera fit was the script's. MapView then sends setSelection and the flight with the target Peek
    // padding because it reads Selection from this one state.
    private Task OnBubbleTapAsync(IReadOnlyList<string> ids) => ApplyAsync(new SheetEvent.BubbleTap(ids));

    // The detail's back arrow is the Android Back from a detail (BackStep.Detail): Peek, the selection kept; in the panel the selection is cleared. It runs through HistorySync so that the
    // history entry of the detail is taken back with it (one entry, D46, R2-04), as the Android Back itself would.
    private async Task OnBackAsync()
    {
        _focusDetail = false;
        await History.BackAsync();
        RefreshMapLayout();
    }

    // S10a: a tile of the Layers popover. The page applies the style at once (MapView sends it through the existing setStyle) and DevicePrefs stores it.
    private async Task OnStyleChosenAsync(string styleId)
    {
        _chosenStyle = styleId;
        await Prefs.SetMapStyleAsync(styleId);
    }

    private Task OnShowZonesChangedAsync(bool show) => Prefs.SetShowZonesAsync(show);

    // A style the person chose did not load (realmMap.js gave up after 8 s and kept the last good one): back to the style before the choice, stored again as well (01 section 4.12).
    // A style that failed at start-up was nobody's choice in this page, so it is left to the script's own fallback.
    private async Task OnStyleFailedAsync(string failedStyleId)
    {
        if (_chosenStyle is null || failedStyleId != _chosenStyle)
        {
            return;
        }

        await Prefs.SetMapStyleAsync(Prefs.PreviousMapStyle);
        Snackbar.Add($"That map style didn't load. Back to {NameOf(Prefs.MapStyle)}.", Severity.Warning);
    }

    // A preference changed (the Layers popover, or the Settings dialog): bring the page in line. Raised on the circuit's context, so no marshalling beyond InvokeAsync.
    private void OnPrefChanged(string key)
    {
        if (_disposed)
        {
            return;
        }

        _ = InvokeAsync(async () =>
        {
            if (key == DevicePrefs.MapStyleKey)
            {
                _chosenStyle = Prefs.MapStyle;
            }
            else if (key == DevicePrefs.ViewRadiusKmKey)
            {
                _mapOptions = MapPayloadOptions.Default with { DefaultViewRadiusKm = Prefs.ViewRadiusKm };
            }
            else if (key == DevicePrefs.LayoutKey)
            {
                _layoutOverride = LayoutResolver.ParseOverride(Overrides?.Layout ?? Prefs.Layout);
                if (_viewport is { } viewport)
                {
                    await ApplyViewportAsync(viewport);
                }
            }

            StateHasChanged();
        });
    }

    // Raised off the UI thread (IRealmSession.Changed): marshal back before rendering.
    private void OnSessionChanged() => Rerender();

    private void OnMinute() => Rerender();

    private void Rerender()
    {
        if (!_disposed)
        {
            _ = InvokeAsync(StateHasChanged);
        }
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        if (_started)
        {
            Session.Changed -= OnSessionChanged;
            Ui.Changed -= OnUiChanged;

            // R1-12: the ten minutes count from the moment the page goes away, not from the last camera move, so the camera is stamped again now.
            if (Ui.LastCamera is { } camera)
            {
                Ui.RecordCamera(camera, Session.Time.GetUtcNow());
            }
        }

        if (_prefsSubscribed)
        {
            Prefs.Changed -= OnPrefChanged;
        }

        if (_ticker is not null)
        {
            _ticker.Tick -= OnMinute;
            _ticker.Dispose();
        }

        if (_history is not null)
        {
            await _history.DisposeAsync();
        }

        if (_shell is not null)
        {
            await _shell.DisposeAsync();
        }
    }
}
