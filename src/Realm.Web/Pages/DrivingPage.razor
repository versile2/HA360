@page "/driving"
@implements IAsyncDisposable
@using Microsoft.JSInterop
@using Realm.Domain
@using Realm.Web.Components.Driving
@using Realm.Web.Formatting
@using Realm.Web.State
@inject NavigationManager Navigation
@inject IDialogService Dialogs
@inject ILogger<DrivingPage> Logger
@inject IJSRuntime JS
@inject RealmUiState Ui
@inject HistorySync History

@* The Weekly Driving Report (01 section 6; 03 section 3.4): a full page, no map and no sheet. The session is RealmShell's cascading value. The selected period is the
   address query (D69, D113): ?week=0..3 for a week chip, ?period=last-month|3m|6m|1y for a long period and ?period=custom&from=YYYY-MM-DD&to=YYYY-MM-DD for a custom range,
   read on every navigation through SupplyParameterFromQuery (ReportPeriod.Parse; a long period the retention does not cover, or a custom range that fails the checks, reads as
   This week) and written back with NavigationManager (a choice is a replace, so Back from Driving still leaves for Location), never taken from the Demo overrides. The report comes from IRealmSession.GetWeekReportAsync(week, snapshot.WeekStart) for a week chip and from GetPeriodReportAsync(window) for a long period; the page renders it and
   decides nothing: every figure, arrow, asterisk of 01 section 6.3 is the data layer's, built into strings by the formatters. The report is fetched again, in place, when
   the snapshot's StatsVersion moves (never polled). The six openers raise OnOpen and the page opens StatPopup with IDialogService (01 section 6.7).

   The browser history (03 section 3.7): the page pushes one sentinel entry when it mounts and each open popup is one more layer (StatPopup registers it). A Back that pops the sentinel with
   no popup open goes to Location (01 section 2.2) with a replace, so Back never exits the app from here; a Back with a popup open closes the popup. *@
<section class="realm-driving" aria-busy="@(_loading ? "true" : "false")">
    <div class="realm-driving__column">
        <header class="realm-driving__header">
            <span class="realm-driving__wordmark">@DrivingFormatter.Wordmark</span>
            <button type="button" class="realm-print-btn realm-no-print" data-testid="btn-print" aria-label="Print the report, or save it as PDF" @onclick="PrintAsync">
                <MudIcon Icon="@Icons.Material.Filled.Print" />
            </button>
        </header>

        <p class="realm-print-only realm-print-header" data-testid="print-header">@PrintHeader</p>

        <PeriodBar Weeks="@_weeks"
                   Period="@_period"
                   LastLong="@Ui.LastLongPeriod"
                   RetentionFixDays="@RetentionDays"
                   Today="@Today"
                   PeriodChanged="OnPeriodAsync" />

        <h1 class="realm-h1 realm-driving__title">@PeriodFormatter.Title(_period)</h1>
        <p class="realm-driving__subtitle">@DrivingFormatter.Subtitle</p>
        <p class="realm-driving__range" role="status">@RangeLine</p>

        @if (_failed)
        {
            <p class="realm-driving__banner" role="status">@DrivingFormatter.ReportUnavailableBanner</p>
        }

        @if (_loading)
        {
            <div class="realm-driving__skeleton" aria-hidden="true">
                <div class="realm-stat-grid">
                    @for (var i = 0; i < StatNameFormatter.ChipKeys.Count; i++)
                    {
                        <div class="realm-skeleton realm-skeleton--chip"></div>
                    }
                </div>
                <div class="realm-card-row">
                    <div class="realm-skeleton realm-skeleton--card"></div>
                    <div class="realm-skeleton realm-skeleton--card"></div>
                </div>
            </div>
        }
        else
        {
            <div class="realm-stat-grid realm-screen-only">
                @foreach (var key in StatNameFormatter.ChipKeys)
                {
                    <StatChip Key="@key" Stat="@StatOf(key)" WeekOffset="@WordsOffset" OnOpen="OpenAsync" />
                }
            </div>

            <div class="realm-card-row realm-screen-only">
                <TopSpeedCard TopSpeed="@_report?.TopSpeed" Driver="@MemberOf(_report?.TopSpeed?.MemberId)" OnOpen="@(() => OpenAsync(StatNameFormatter.TopSpeedKey))" />
                <DrivesCard Totals="@Totals" OnOpen="@(() => OpenAsync(StatNameFormatter.DrivesKey))" />
            </div>

            @if (_report is { } report)
            {
                @if (ShowQuietWeek(report))
                {
                    <p class="realm-driving__quiet">@DrivingFormatter.NoDrivesCurrentWeek</p>
                }
                else if (_period.IsLong && report.Coverage != WeekCoverage.NoRecord && report.Totals.Drives == 0)
                {
                    <p class="realm-driving__quiet">@DrivingFormatter.NoDrivesPeriod</p>
                }

                <div class="realm-driver-list realm-screen-only">
                    @foreach (var driver in report.Drivers)
                    {
                        <DriverCard @key="driver.MemberId" Driver="@driver" Member="@MemberOf(driver.MemberId)" Period="@_period" />
                    }
                </div>

                @* The printed report: tables of the totals and the drivers (01 section 6.10); the cards, chips and map are drawn for the screen only. *@
                <table class="realm-print-only realm-print-table" data-testid="print-totals">
                    <caption>Totals</caption>
                    <thead>
                        <tr>
                            @foreach (var column in PrintFormatter.TotalsColumns)
                            {
                                <th scope="col">@column</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in PrintFormatter.Totals(report, NameOf, Session.Zone))
                        {
                            <tr>
                                @foreach (var cell in row.Cells)
                                {
                                    <td>@cell</td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>

                <table class="realm-print-only realm-print-table" data-testid="print-drivers">
                    <caption>Drivers</caption>
                    <thead>
                        <tr>
                            @foreach (var column in PrintFormatter.DriverColumns)
                            {
                                <th scope="col">@column</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in PrintFormatter.Drivers(report, NameOf))
                        {
                            <tr>
                                @foreach (var cell in row.Cells)
                                {
                                    <td>@cell</td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>

                @if (ShowDistanceCaption(report))
                {
                    <p class="realm-driving__caption realm-screen-only">@(StatNameFormatter.DistanceCaption + ".")</p>
                }
            }
        }

        <p class="realm-print-only realm-print-footer" data-testid="print-footer">@PeriodFormatter.PrintFooter(Session.Current.Thresholds)</p>
    </div>
</section>

@code {
    // Esc and the scrim close the popup; the scrim is the Realm's own (realm-driving.css), and the dialog has no header close button because the popup draws its own.
    private static readonly DialogOptions PopupOptions = new()
    {
        CloseOnEscapeKey = true,
        BackdropClick = true,
        CloseButton = false,
        BackgroundClass = "realm-popup-scrim",
    };

    private readonly CancellationTokenSource _lifetime = new();
    private CancellationTokenSource? _load;
    private IReadOnlyList<WeekRef> _weeks = [];
    private Dictionary<string, MemberVm> _members = new(StringComparer.Ordinal);
    private WeekReportVm? _report;
    private ReportPeriod _period = ReportPeriod.ThisWeek;
    private ReportPeriod? _loadedPeriod;
    private ReportWindow? _window;
    private int _statsVersion = -1;
    private bool _loading = true;
    private bool _failed;
    private bool _subscribed;
    private bool _disposed;
    private IAsyncDisposable? _history;

    /// <summary>The circuit's session, cascaded by <c>RealmShell</c>.</summary>
    [CascadingParameter]
    public IRealmSession Session { get; set; } = default!;

    /// <summary><c>?week=0..3</c>: an ordinary route query, honoured in every mode (01 Appendix B, D69). Anything else is This week.</summary>
    [SupplyParameterFromQuery(Name = "week")]
    public string? WeekQuery { get; set; }

    /// <summary><c>?period=last-month|3m|6m|1y|custom</c>: a long period; it wins over <c>week</c> (01 section 6.2, D113).</summary>
    [SupplyParameterFromQuery(Name = "period")]
    public string? PeriodQuery { get; set; }

    /// <summary><c>?from=YYYY-MM-DD</c>, with <c>period=custom</c>.</summary>
    [SupplyParameterFromQuery(Name = "from")]
    public string? FromQuery { get; set; }

    /// <summary><c>?to=YYYY-MM-DD</c>, with <c>period=custom</c>.</summary>
    [SupplyParameterFromQuery(Name = "to")]
    public string? ToQuery { get; set; }

    // The Drives card reads "—" for a week nobody was recorded in: nothing was counted, which is not the same as no drives.
    private WeekTotals? Totals => _report is null || _report.Coverage == WeekCoverage.NoRecord ? null : _report.Totals;

    // While the report loads the line is empty; when it cannot be read the plain range of the chip stands in for it.
    private string RangeLine =>
        _report is not null ? DrivingFormatter.RangeLine(_report, Session.Zone)
        : _loading || _window is null ? string.Empty
        : DrivingFormatter.RangeText(_window.Start, _window.End);

    // The period words of the sentences: the week chip's offset, or "in this period" for a long period.
    private int WordsOffset => _period.IsLong ? StatNameFormatter.LongPeriod : _period.WeekOffset;

    private int RetentionDays => Session.Current.RetentionFixDays;

    private DateOnly Today => PeriodMath.Today(Session.Time.GetUtcNow(), Session.Zone);

    // The header of the printed page: "Driving Report · Last month · Aug 1 – Aug 31 · printed Oct 8, 2026".
    private string PrintHeader => _window is null ? DrivingFormatter.PeriodTitle : PeriodFormatter.PrintHeader(_window, Today);

    private string NameOf(string memberId) => MemberOf(memberId)?.DisplayName ?? memberId;

    private EventStat? StatOf(string key) => _report is not null && _report.Events.TryGetValue(key, out var stat) ? stat : null;

    private MemberVm? MemberOf(string? id) => id is not null && _members.TryGetValue(id, out var member) ? member : null;

    // 01 section 8.7: the current week with nothing driven yet. A week nobody was recorded in says so in the range line instead.
    private static bool ShowQuietWeek(WeekReportVm report) => report.IsCurrent && report.Coverage != WeekCoverage.NoRecord && report.Totals.Drives == 0;

    // 01 section 6.4 (R-111): the caption follows the distance basis, GPS in v1, and has nothing to say about a week without distances.
    private static bool ShowDistanceCaption(WeekReportVm report) =>
        report.Coverage != WeekCoverage.NoRecord && report.DistanceBasis is DistanceBasis.Gps or DistanceBasis.Mixed;

    // Prerendering runs this twice (the prerender scope, then the circuit); both only read the session and the query.
    protected override async Task OnParametersSetAsync()
    {
        RefreshChips();
        var snapshot = Session.Current;
        var now = Session.Time.GetUtcNow();
        var period = Allowed(ReportPeriod.Parse(PeriodQuery, FromQuery, ToQuery, WeekQuery), now, snapshot.RetentionFixDays);
        _period = period;
        _window = PeriodMath.Resolve(period, now, snapshot.WeekStart, Session.Zone);
        Ui.SelectedWeek = period.IsLong ? 0 : period.WeekOffset;
        if (period.IsLong)
        {
            Ui.LastLongPeriod = period;
        }

        if (period == _loadedPeriod)
        {
            return;
        }

        _loadedPeriod = period;
        _report = null;
        _loading = true;
        _failed = false;
        await LoadAsync(period, blank: true);
    }

    // A deep link may name a period this install does not offer: 3, 6 and 12 months need the retention to cover them (PeriodMath.IsAvailable) and a custom range must pass the
    // checks of the pickers. Anything else reads as This week.
    private ReportPeriod Allowed(ReportPeriod period, DateTimeOffset now, int retentionDays) =>
        period.Kind switch
        {
            PeriodKind.Week or PeriodKind.LastMonth => period,
            PeriodKind.Custom => PeriodMath.ValidateCustom(period.From, period.To, now, Session.Zone, retentionDays).IsValid ? period : ReportPeriod.ThisWeek,
            _ => PeriodMath.IsAvailable(period.Kind, retentionDays) ? period : ReportPeriod.ThisWeek,
        };

    // The circuit exists from the first render on: only now can the page listen for the snapshot's StatsVersion and attach the browser history.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _subscribed || _disposed)
        {
            return;
        }

        _subscribed = true;
        Session.Changed += OnSessionChanged;

        // A trip may have been closed between the load and the subscription.
        OnSessionChanged();

        await AttachHistoryAsync();
    }

    // The Driving surface of HistorySync: one sentinel entry above the page, and the way out when the person goes Back past it. A browser or circuit that refuses leaves the page without it.
    private async Task AttachHistoryAsync()
    {
        try
        {
            var lease = await HistoryInterop.AttachAsync(History, JS, HistorySurface.Driving, LeaveAsync);
            if (_disposed)
            {
                await lease.DisposeAsync();
                return;
            }

            _history = lease;
        }
        catch (Exception exception) when (exception is JSException or JSDisconnectedException or OperationCanceledException)
        {
            Logger.LogWarning(exception, "The Driving page could not attach the browser history.");
        }
    }

    // Back from the root of Driving goes to Location, never out of the app: the sentinel is already popped, so the entry the page sits on is replaced.
    private Task LeaveAsync() => _disposed ? Task.CompletedTask : InvokeAsync(() => Navigation.NavigateTo("./", replace: true));

    private void RefreshChips()
    {
        var snapshot = Session.Current;
        _weeks = WeekMath.Chips(Session.Time.GetUtcNow(), snapshot.WeekStart, Session.Zone);
        _members = snapshot.Members.ToDictionary(member => member.Id, StringComparer.Ordinal);
    }

    // One load at a time: a newer one (another period, or a new StatsVersion) cancels the one in flight, whose result is then dropped.
    private async Task LoadAsync(ReportPeriod period, bool blank)
    {
        _load?.Cancel();
        _load?.Dispose();
        var load = CancellationTokenSource.CreateLinkedTokenSource(_lifetime.Token);
        _load = load;
        var token = load.Token;
        var snapshot = Session.Current;
        try
        {
            var report = period.Kind == PeriodKind.Week
                ? await Session.GetWeekReportAsync(period.WeekOffset, snapshot.WeekStart, token)
                : await Session.GetPeriodReportAsync(PeriodMath.Resolve(period, Session.Time.GetUtcNow(), snapshot.WeekStart, Session.Zone), token);
            if (token.IsCancellationRequested || _disposed)
            {
                return;
            }

            _report = report;
            _statsVersion = snapshot.StatsVersion;
            _failed = false;
        }
        catch (OperationCanceledException)
        {
            return;
        }
        catch (Exception exception)
        {
            // 01 section 6.9: the report cannot be read. The banner says so and every chip reads "—"; the page keeps what it had unless it was blanked for a new week.
            Logger.LogError(exception, "The driving report could not be loaded for {Period}.", period.Query());
            if (token.IsCancellationRequested || _disposed)
            {
                return;
            }

            // The version is taken as seen, so a persistent failure is not retried on every snapshot: the next trip written asks again.
            _statsVersion = snapshot.StatsVersion;
            _failed = true;
            if (blank)
            {
                _report = null;
            }
        }

        _loading = false;
    }

    // A choice (a chip, the split button or an applied custom range): write it back to the query (replace, so Back from Driving still leaves for Location). This week is the
    // default and leaves no parameter; a week leaves no period, from or to, and a long period leaves no week.
    private Task OnPeriodAsync(ReportPeriod period)
    {
        if (period != _period)
        {
            if (period.IsLong)
            {
                Ui.LastLongPeriod = period;
            }

            var query = new Dictionary<string, object?>(StringComparer.Ordinal)
            {
                ["week"] = period.Kind == PeriodKind.Week && period.WeekOffset != 0 ? period.WeekOffset.ToString(System.Globalization.CultureInfo.InvariantCulture) : null,
                ["period"] = ReportPeriod.QueryValueOf(period.Kind),
                ["from"] = period.Kind == PeriodKind.Custom && period.From is { } from ? ReportPeriod.Iso(from) : null,
                ["to"] = period.Kind == PeriodKind.Custom && period.To is { } to ? ReportPeriod.Iso(to) : null,
            };
            Navigation.NavigateTo(Navigation.GetUriWithQueryParameters(query), replace: true);
        }

        return Task.CompletedTask;
    }

    // The browser's print dialog: the print stylesheet (css/realm-print.css) draws the report as tables on a light page. Every Driving page has the button (01 section 6.10).
    private async Task PrintAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("print");
        }
        catch (Exception exception) when (exception is JSException or JSDisconnectedException or TaskCanceledException)
        {
            Logger.LogWarning(exception, "The Driving page could not open the print dialog.");
        }
    }

    // The popup of one of the six openers (01 section 6.7): a MudBlazor dialog with the week report the page shows. Esc and the scrim close it; MudBlazor returns the focus to the
    // opener, which still has it when the dialog first renders. The popup renders from the report it was given, so the figures cannot change under it.
    private async Task OpenAsync(string key)
    {
        IReadOnlyDictionary<string, MemberVm> members = _members;
        var parameters = new DialogParameters<StatPopup>
        {
            { popup => popup.Key, key },
            { popup => popup.Report, _report },
            { popup => popup.Members, members },
            { popup => popup.WeekOffset, WordsOffset },
            { popup => popup.Zone, Session.Zone },
        };
        await Dialogs.ShowAsync<StatPopup>(null, parameters, PopupOptions);
    }

    // Raised off the UI thread (IRealmSession.Changed): marshal back before touching state. The report is fetched again, in place, only when StatsVersion moved.
    private void OnSessionChanged()
    {
        var period = _loadedPeriod;
        if (_disposed || period is null || Session.Current.StatsVersion == _statsVersion)
        {
            return;
        }

        _ = InvokeAsync(async () =>
        {
            if (_disposed)
            {
                return;
            }

            await LoadAsync(period, blank: false);
            StateHasChanged();
        }).ContinueWith(
            static task => _ = task.Exception, // R3-14: observe a dispatcher fault of a closed circuit
            CancellationToken.None,
            TaskContinuationOptions.OnlyOnFaulted | TaskContinuationOptions.ExecuteSynchronously,
            TaskScheduler.Default);
    }

    public ValueTask DisposeAsync()
    {
        _disposed = true;
        if (_subscribed)
        {
            Session.Changed -= OnSessionChanged;
        }

        _lifetime.Cancel();
        _load?.Dispose();
        _lifetime.Dispose();
        return _history is { } history ? history.DisposeAsync() : ValueTask.CompletedTask;
    }
}
