@page "/driving/{MemberId}"
@implements IAsyncDisposable
@using Realm.Domain
@using Realm.Web.Components.Driving
@using Realm.Web.Formatting
@inject NavigationManager Navigation
@inject ILogger<DriverWeekPage> Logger

@* The driver's week (01 section 6.6; 03 sections 3.3 and 3.4): a full page like Driving, with a Back link to driving?week=n (relative, like
   every link), the driver's avatar, name and lore, and the week under them; the body is DriverWeekDetail. The member comes from the snapshot (the avatar and the name need no wait) and the figures from
   IRealmSession.GetDriverWeekAsync(memberId, week, snapshot.WeekStart); the driver's top speed is the report's per-driver speed (01 section 6.8), so the week report is read too and a
   failure of that second read only leaves the tile "—". ?week= is read on every navigation (D69), in every mode. An id that names no report driver (the static prince, an
   unknown id) gets null from the session and the page redirects to driving, replacing the history entry, so Back does not return to a page that cannot render. Nothing here
   listens for new trips: the week is fetched once per (member, week). *@
<section class="realm-driving realm-driver-week" aria-busy="@(_loading ? "true" : "false")">
    <div class="realm-driving__column">
        <header class="realm-driving__header">
            <span class="realm-driving__wordmark">@DrivingFormatter.Wordmark</span>
        </header>

        <div class="realm-driver-week__bar">
            <a class="realm-driver-week__back" href="@DrivingFormatter.BackHref(_week)" data-testid="detail-back" aria-label="@DrivingFormatter.BackLabel">
                <MudIcon Icon="@Icons.Material.Filled.ArrowBack" />
            </a>
            <DriverAvatar Name="@Name" MemberColor="@_member?.Color" AvatarUrl="@_member?.AvatarUrl" Diameter="48" Ring="true" />
            <div class="realm-driver-week__who">
                <h1 class="realm-driver-week__name">@Name</h1>
                @if (!string.IsNullOrWhiteSpace(_member?.LoreTitle))
                {
                    <p class="realm-driver-week__lore">@(_member?.LoreTitle)</p>
                }
                <p class="realm-driver-week__week">@WeekLabel</p>
            </div>
        </div>

        @if (_failed)
        {
            <p class="realm-driving__banner" role="status">@DrivingFormatter.ReportUnavailableBanner</p>
        }

        @if (_data is { } data)
        {
            <DriverWeekDetail Data="@data" TopSpeedMps="@_topSpeedMps" Zone="@Session.Zone" />
        }
        else if (_loading)
        {
            <div class="realm-driving__skeleton" aria-hidden="true">
                <div class="realm-week-tiles">
                    @for (var i = 0; i < 4; i++)
                    {
                        <div class="realm-skeleton realm-skeleton--tile"></div>
                    }
                </div>
            </div>
        }
    </div>
</section>

@code {
    private readonly CancellationTokenSource _lifetime = new();
    private CancellationTokenSource? _load;
    private IReadOnlyList<WeekRef> _weeks = [];
    private MemberVm? _member;
    private DriverWeek? _data;
    private double? _topSpeedMps;
    private string? _loadedMember;
    private int _loadedWeek = -1;
    private int _week;
    private bool _loading = true;
    private bool _failed;
    private bool _disposed;

    /// <summary>The circuit's session, cascaded by <c>RealmShell</c>.</summary>
    [CascadingParameter]
    public IRealmSession Session { get; set; } = default!;

    /// <summary>The member id of the route, a role id such as <c>jester</c>.</summary>
    [Parameter]
    public string MemberId { get; set; } = string.Empty;

    /// <summary><c>?week=0..3</c>: an ordinary route query, honoured in every mode (01 Appendix B, D69). Anything else is This week.</summary>
    [SupplyParameterFromQuery(Name = "week")]
    public string? WeekQuery { get; set; }

    private string Name => _member?.DisplayName ?? MemberId;

    // The week under the name: "This week · Sep 28 – Oct 4". The chips of the snapshot's week start give the range.
    private string WeekLabel => _week < _weeks.Count ? DrivingFormatter.WeekHeading(_weeks[_week]) : string.Empty;

    // Prerendering runs this twice (the prerender scope, then the circuit); both only read the session and the query.
    protected override async Task OnParametersSetAsync()
    {
        var snapshot = Session.Current;
        _weeks = WeekMath.Chips(Session.Time.GetUtcNow(), snapshot.WeekStart, Session.Zone);
        _member = snapshot.Members.FirstOrDefault(member => string.Equals(member.Id, MemberId, StringComparison.Ordinal));
        _week = DrivingFormatter.ParseWeek(WeekQuery);
        if (_week == _loadedWeek && string.Equals(MemberId, _loadedMember, StringComparison.Ordinal))
        {
            return;
        }

        _loadedMember = MemberId;
        _loadedWeek = _week;
        _data = null;
        _topSpeedMps = null;
        _loading = true;
        _failed = false;
        await LoadAsync(MemberId, _week, snapshot.WeekStart);
    }

    // One load at a time: a newer one (another member or week) cancels the one in flight, whose result is then dropped.
    private async Task LoadAsync(string memberId, int week, DayOfWeek weekStart)
    {
        _load?.Cancel();
        _load?.Dispose();
        var load = CancellationTokenSource.CreateLinkedTokenSource(_lifetime.Token);
        _load = load;
        var token = load.Token;
        DriverWeek? data = null;
        double? topSpeed = null;
        var loaded = false;
        try
        {
            data = await Session.GetDriverWeekAsync(memberId, week, weekStart, token);
            if (data is not null)
            {
                topSpeed = await TopSpeedAsync(memberId, week, weekStart, token);
            }

            loaded = true;
        }
        catch (OperationCanceledException)
        {
            return;
        }
        catch (Exception exception)
        {
            // The week cannot be read: the banner says so and the page stays on its header; the Back link still works.
            Logger.LogError(exception, "The driver week of {MemberId} could not be loaded for week {Week}.", memberId, week);
        }

        if (token.IsCancellationRequested || _disposed)
        {
            return;
        }

        if (loaded && data is null)
        {
            // Not a report driver (01 section 6.6): back to the report, replacing this entry. Never inside the try above: in a prerender NavigateTo ends the request with a redirect.
            Navigation.NavigateTo("driving", replace: true);
            return;
        }

        _data = data;
        _topSpeedMps = topSpeed;
        _failed = !loaded;
        _loading = false;
    }

    // The driver's top speed is the report's per-driver speed. The tile reads "—" when the report cannot be read; only the week itself is worth a banner.
    private async Task<double?> TopSpeedAsync(string memberId, int week, DayOfWeek weekStart, CancellationToken token)
    {
        try
        {
            var report = await Session.GetWeekReportAsync(week, weekStart, token);
            return DrivingFormatter.TopSpeedOf(report, memberId);
        }
        catch (Exception exception) when (exception is not OperationCanceledException)
        {
            Logger.LogWarning(exception, "The week report could not be read for the top speed of {MemberId} in week {Week}.", memberId, week);
            return null;
        }
    }

    public ValueTask DisposeAsync()
    {
        _disposed = true;
        _lifetime.Cancel();
        _load?.Dispose();
        _lifetime.Dispose();
        return ValueTask.CompletedTask;
    }
}
