@using Microsoft.JSInterop
@using Realm.Domain

@* The three-tab control under the handle (01 section 5.0; 03 section 3.4): Drivers, Vehicles, Places. role=tablist with a roving tabindex and arrow-key
   focus; below 360 px only the icons show (the label stays for the accessible name). The count of the section that shows ("5 drivers") is announced by the sheet's one live region
   (SheetContent), which stays on the page while the selection header takes this control's place. A new FocusRequest for the section tab (01 section 10.2: the selection was cleared) puts the
   focus on the tab that shows, once per request. *@
<div class="realm-segments" role="tablist" aria-label="Sections" data-testid="sheet-segments">
    @foreach (var segment in All)
    {
        var selected = segment.Section == Section;
        <button @key="segment.Section"
                @ref="_tabs[(int)segment.Section]"
                type="button"
                role="tab"
                class="realm-segment"
                id="@TabId(segment.Section)"
                data-testid="@segment.TestId"
                aria-selected="@(selected ? "true" : "false")"
                aria-controls="@PanelId"
                tabindex="@(selected ? 0 : -1)"
                @onclick="() => SelectAsync(segment.Section)"
                @onkeydown="args => KeyDownAsync(args, segment.Section)">
            <MudIcon Icon="@segment.Icon" />
            <span class="realm-segment-label">@segment.Label</span>
        </button>
    }
</div>

@code {
    private sealed record Segment(Section Section, string Label, string Icon, string TestId);

    /// <summary>The id the list panel carries (<c>aria-controls</c> of every tab, and the panel's own id in <c>SheetContent</c>).</summary>
    public const string PanelId = "realm-sheet-panel";

    private static readonly Segment[] All =
    [
        new(Section.Drivers, "Drivers", Icons.Material.Filled.Group, "tab-drivers"),
        new(Section.Vehicles, "Vehicles", Icons.Material.Filled.DirectionsCar, "tab-vehicles"),
        new(Section.Places, "Places", Icons.Material.Filled.Place, "tab-places"),
    ];

    private readonly ElementReference[] _tabs = new ElementReference[3];
    private bool _focusSelected;
    private FocusRequest? _handled;

    /// <summary>The selected section (Drivers by default).</summary>
    [Parameter]
    public Section Section { get; set; } = Section.Drivers;

    /// <summary>The page's request to move the focus (01 section 10.2). One that names <see cref="FocusTarget.SectionTab"/> and has not been acted on yet puts the focus on the tab that shows, after this render.</summary>
    [Parameter]
    public FocusRequest? Focus { get; set; }

    /// <summary>A tab was chosen, by tap or by the arrow keys.</summary>
    [Parameter]
    public EventCallback<Section> OnSection { get; set; }

    /// <summary>The id of the tab of <paramref name="section"/>; the list panel is labelled by the selected one.</summary>
    public static string TabId(Section section) => $"realm-tab-{section.ToString().ToLowerInvariant()}";

    private Task SelectAsync(Section section) => OnSection.InvokeAsync(section);

    // Left and Right move to the neighbour (wrapping), Home and End to the ends; focus follows the selection, as in the ARIA tabs pattern with automatic activation.
    private async Task KeyDownAsync(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs args, Section from)
    {
        var index = (int)from;
        var target = args.Key switch
        {
            "ArrowRight" => (index + 1) % All.Length,
            "ArrowLeft" => (index + All.Length - 1) % All.Length,
            "Home" => 0,
            "End" => All.Length - 1,
            _ => -1,
        };
        if (target < 0)
        {
            return;
        }

        _focusSelected = true;
        await OnSection.InvokeAsync(All[target].Section);
    }

    protected override void OnParametersSet()
    {
        if (Focus is { Target: FocusTarget.SectionTab } request && !ReferenceEquals(request, _handled))
        {
            _handled = request;
            _focusSelected = true;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_focusSelected)
        {
            return;
        }

        _focusSelected = false;
        try
        {
            await _tabs[(int)Section].FocusAsync();
        }
        catch (Exception exception) when (exception is JSException or JSDisconnectedException or InvalidOperationException or TaskCanceledException)
        {
            // A circuit that is gone, or a tab that has already left the page: there is nothing to focus.
        }
    }
}
