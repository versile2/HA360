@using Realm.Domain
@using Realm.Web.Formatting
@using Realm.Web.Sheet
@using Realm.Web.State
@implements IDisposable

@* The body of the sheet (03 section 3.4): the three-tab control and the list of the section that shows, or, with something selected, the selection header or the detail. Container-agnostic: the
   same markup fills the MudX bottom sheet, the MudX left panel and the aside fallback, and nothing here knows about MudX. In the bottom sheet the summary line lives in the handle; in the
   panel, which has no handle, ShowSummary puts it here as the panel's header (01 section 3.6). The surface is drawn by the contract element (css/realm-sheet.css), not by this root.
   What shows is Body, which the page takes from RealmUiState and which SheetBody.BodyOf derives from (selection, size, layout) (D45, 01 section 5.7): the List (the segments and the section's
   list, at Peek under the navigation bar where the CSS hides it), the Header (at Peek the selection header takes the segments' place and nothing is below it), or the Detail (the segments,
   then the person, vehicle or place detail; in the Expanded panel a selection is always the detail). A selection that is no longer in the lists has no header and no detail: the list shows.
   The rows are MemberRow, VehicleRow and PlaceRow, identical in both layouts: their strings come from VmFactory, built here once per render from the lists and the session's clock and zone
   (never the browser's). A tap raises OnSelect with the entity; the page turns it into the selection. The header's body raises OnToggle and its X raises OnClear (D46); the detail's back arrow
   raises OnBack and a person in a place's Here-now list raises OnHereNow. The page wires OnToggle to the handler of the handle's own tap, so there is one code path; this component decides
   nothing about sizes. FocusDetail asks a detail that has just opened to take the focus (01 section 10.2). The one polite live region of the sheet (01 section 10.3) is here, outside the segments and the list, so it stays on
   the page whatever the body is: it says what the page hands it in Announcement and nothing of its own.
   Before the first data snapshot (no people, no vehicles and no places: FirstDataWatch.IsPending, the rule of the "Summoning the court…" summary) the list is three SkeletonRows (01 section 3.8),
   and past 20 s of that wait, the circuit's FirstDataWatch says Failed and the error with its Retry button takes their place (01 section 8.6; FirstDataState). The skeleton list has no
   data-testid="sheet-list": that id is the list of rows. A bare render with no watch never reaches the error. *@
@{
    var facts = RowFacts.Create(Members, Places, MeId, Moment, Zone ?? Session?.Zone ?? TimeZoneInfo.Utc);
    var selected = Body switch
    {
        SheetBody.Header header => header.Entity,
        SheetBody.Detail detail => detail.Entity,
        _ => null,
    };
    var selectionHeader = Body is SheetBody.Header && selected is not null ? SelectionHeaderFormatter.For(selected, Members, Vehicles, Places, facts) : null;
    var member = Body is SheetBody.Detail ? FindMember(selected) : null;
    var vehicle = Body is SheetBody.Detail ? FindVehicle(selected) : null;
    var place = Body is SheetBody.Detail ? FindPlace(selected) : null;
    var showDetail = member is not null || vehicle is not null || place is not null;
    var pending = FirstDataWatch.IsPending(Members, Vehicles, Places);
    _stageAtRender = FirstData?.Stage;
}
<div class="realm-sheet-content" data-testid="sheet-content">
    @if (ShowSummary)
    {
        <p class="realm-sheet-summary realm-sheet-summary--panel" data-testid="sheet-summary">@Summary</p>
    }

    @if (selectionHeader is not null)
    {
        <SheetSelectionHeader Header="selectionHeader" OnToggle="OnToggle" OnClear="OnClear" />
    }
    else
    {
        <SheetSegments Section="Section" Focus="Focus" OnSection="OnSection" />
    }

    @if (showDetail)
    {
        <div class="realm-sheet-list-wrap realm-sheet-detail-wrap" id="@SheetSegments.PanelId" role="tabpanel" aria-labelledby="@SheetSegments.TabId(Section)">
            @if (member is not null)
            {
                <MemberDetail @key="member.Id" Member="member" Facts="facts" FocusOnOpen="FocusDetail" OnBack="OnBack" />
            }
            else if (vehicle is not null)
            {
                <VehicleDetail @key="vehicle.Id" Vehicle="vehicle" Facts="facts" FocusOnOpen="FocusDetail" OnBack="OnBack" />
            }
            else if (place is not null)
            {
                <PlaceDetail @key="place.Id" Place="place" Vehicles="Vehicles" Facts="facts" FocusOnOpen="FocusDetail" OnBack="OnBack" OnSelect="HereNowAsync" />
            }
        </div>
    }
    else if (selectionHeader is null)
    {
        <div class="realm-sheet-list-wrap" id="@SheetSegments.PanelId" role="tabpanel" aria-labelledby="@SheetSegments.TabId(Section)" aria-busy="@(pending ? "true" : null)">
            @if (pending && FirstData is { Stage: FirstDataStage.Failed })
            {
                <FirstDataState />
            }
            else if (pending)
            {
                <ul class="realm-sheet-list realm-skeleton-list" aria-hidden="true">
                    @for (var i = 0; i < SkeletonRowCount; i++)
                    {
                        <SkeletonRow @key="i" Kind="Section" />
                    }
                </ul>
            }
            else
            {
                <ul class="realm-sheet-list" data-testid="sheet-list">
                    @if (Section == Section.Vehicles)
                    {
                        foreach (var row in VmFactory.VehicleRows(Vehicles, facts))
                        {
                            <li @key="row.Id" class="realm-sheet-item">
                                <VehicleRow Row="row" OnClick="() => SelectAsync(EntityKind.Vehicle, row.Id)" />
                            </li>
                        }
                    }
                    else if (Section == Section.Places)
                    {
                        foreach (var row in VmFactory.PlaceRows(Places, facts))
                        {
                            <li @key="row.Id" class="realm-sheet-item">
                                <PlaceRow Row="row" OnClick="() => SelectAsync(EntityKind.Place, row.Id)" />
                            </li>
                        }
                    }
                    else
                    {
                        foreach (var row in VmFactory.MemberRows(Members, facts))
                        {
                            <li @key="row.Id" class="realm-sheet-item">
                                <MemberRow Row="row" OnClick="() => SelectAsync(EntityKind.Member, row.Id)" />
                            </li>
                        }
                    }
                </ul>
            }
        </div>
    }

    <span class="realm-sr-only" role="status" aria-live="polite" aria-atomic="true" data-testid="sheet-announce">@Announcement</span>
</div>

@code {
    /// <summary>The people, in sort order (the Drivers list).</summary>
    [Parameter]
    public IReadOnlyList<MemberVm> Members { get; set; } = [];

    /// <summary>The vehicles, in sort order.</summary>
    [Parameter]
    public IReadOnlyList<VehicleVm> Vehicles { get; set; } = [];

    /// <summary>The places; the list shows them occupied first (01 section 5.3).</summary>
    [Parameter]
    public IReadOnlyList<PlaceVm> Places { get; set; } = [];

    /// <summary>The section that shows.</summary>
    [Parameter]
    public Section Section { get; set; } = Section.Drivers;

    /// <summary>A tab was chosen.</summary>
    [Parameter]
    public EventCallback<Section> OnSection { get; set; }

    /// <summary>A row was tapped: the person, vehicle or place it stands for. The page turns it into the selection (a <c>RowTap</c>). The chariot placeholder never raises it.</summary>
    [Parameter]
    public EventCallback<EntityRef> OnSelect { get; set; }

    /// <summary>What shows (D45): the list, the selection header or the detail, as <c>SheetBody.BodyOf</c> derives it. Default: the list.</summary>
    [Parameter]
    public SheetBody Body { get; set; } = new SheetBody.List();

    /// <summary>A tap on the selection header anywhere but its X (D46). The page handles it as it does a tap on the handle (<c>HandleToggle</c>).</summary>
    [Parameter]
    public EventCallback OnToggle { get; set; }

    /// <summary>The X of the selection header: clear the selection (<c>ClearTap</c>).</summary>
    [Parameter]
    public EventCallback OnClear { get; set; }

    /// <summary>The back arrow of a detail: the same step as the Android Back (<c>BackStep.Detail</c>: Peek, the selection kept).</summary>
    [Parameter]
    public EventCallback OnBack { get; set; }

    /// <summary>A person in a place detail's Here-now list was tapped: their id. The page moves the selection from the place to them, at Peek (<c>HereNowTap</c>).</summary>
    [Parameter]
    public EventCallback<string> OnHereNow { get; set; }

    /// <summary>True while a detail that has just been opened by the handle or by a tap on the header should take the focus on its back button (01 section 10.2).</summary>
    [Parameter]
    public bool FocusDetail { get; set; }

    /// <summary>The page's request to move the focus (01 section 10.2), handed to the section tabs: a new one that names the section tab puts the focus on the tab that shows. The handle is the host's.</summary>
    [Parameter]
    public FocusRequest? Focus { get; set; }

    /// <summary>The text of the sheet's one polite live region ("Showing Cass", "Details opened", "List opened", "List collapsed", "4 drivers"); the page derives it from the state's transitions (<c>SheetAnnouncements</c>). Empty says nothing.</summary>
    [Parameter]
    public string Announcement { get; set; } = string.Empty;

    /// <summary>The summary line of 01 section 8.2, shown here only when <see cref="ShowSummary"/> is true.</summary>
    [Parameter]
    public string Summary { get; set; } = string.Empty;

    /// <summary>True in the Expanded panel, which has no handle to carry the summary.</summary>
    [Parameter]
    public bool ShowSummary { get; set; }

    /// <summary>The instant the rows are written at. Default: the session's clock, so Demo's frozen time reaches every string.</summary>
    [Parameter]
    public DateTimeOffset? Now { get; set; }

    /// <summary>The zone clock times are shown in. Default: the session's zone.</summary>
    [Parameter]
    public TimeZoneInfo? Zone { get; set; }

    /// <summary>The viewer's member id (distances on a row are measured from them); null for the first live member, as the map resolves it.</summary>
    [Parameter]
    public string? MeId { get; set; }

    /// <summary>The circuit's session, cascaded by <c>RealmShell</c> (it reaches the popover the sheet is drawn in). Absent in a bare component test.</summary>
    [CascadingParameter]
    public IRealmSession? Session { get; set; }

    /// <summary>The circuit's first-data deadlines, cascaded by <c>RealmShell</c>. Absent in a bare component test: the skeleton rows still show before data, the error never does.</summary>
    [CascadingParameter]
    public FirstDataWatch? FirstData { get; set; }

    /// <summary>The skeleton rows of 01 section 3.8: three.</summary>
    private const int SkeletonRowCount = 3;

    private FirstDataWatch? _watching;
    private FirstDataStage? _stageAtRender;
    private bool _disposed;

    // The stage moves on a timer, not on a parameter, so the content subscribes to re-render when it does; only the circuit runs this (prerender runs no OnAfterRender), so a subscription is
    // made only where it will be disposed. A stage that moved between the render and the subscription is caught by comparing with the one the render saw.
    protected override void OnAfterRender(bool firstRender)
    {
        if (!firstRender || FirstData is not { } watch)
        {
            return;
        }

        watch.Changed += OnFirstDataChanged;
        _watching = watch;
        if (watch.Stage != _stageAtRender)
        {
            StateHasChanged();
        }
    }

    // Raised from a timer's thread: marshal, and never touch a disposed component.
    private void OnFirstDataChanged()
    {
        if (_disposed)
        {
            return;
        }

        _ = InvokeAsync(() =>
        {
            if (!_disposed)
            {
                StateHasChanged();
            }
        });
    }

    /// <inheritdoc />
    public void Dispose()
    {
        _disposed = true;
        if (_watching is { } watch)
        {
            watch.Changed -= OnFirstDataChanged;
        }
    }

    // The session's own clock, never the wall clock. Only a render with neither an explicit Now nor a session (a bare component test) falls back to the system clock.
    private DateTimeOffset Moment => Now ?? Session?.Time.GetUtcNow() ?? TimeProvider.System.GetUtcNow();

    private Task SelectAsync(EntityKind kind, string id) => OnSelect.InvokeAsync(new EntityRef(kind, id));

    private Task HereNowAsync(EntityRef entity) => OnHereNow.InvokeAsync(entity.Id);

    private MemberVm? FindMember(EntityRef? entity) =>
        entity is { Kind: EntityKind.Member } selected ? Members.FirstOrDefault(member => string.Equals(member.Id, selected.Id, StringComparison.Ordinal)) : null;

    private VehicleVm? FindVehicle(EntityRef? entity) =>
        entity is { Kind: EntityKind.Vehicle } selected ? Vehicles.FirstOrDefault(vehicle => string.Equals(vehicle.Id, selected.Id, StringComparison.Ordinal)) : null;

    private PlaceVm? FindPlace(EntityRef? entity) =>
        entity is { Kind: EntityKind.Place } selected ? Places.FirstOrDefault(place => string.Equals(place.Id, selected.Id, StringComparison.Ordinal)) : null;
}
