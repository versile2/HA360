@using Realm.Domain
@using Realm.Web.Sheet

@* The body of the sheet (03 section 3.4): the three-tab control and the list of the section that shows. Container-agnostic: the same markup fills the MudX
   bottom sheet, the MudX left panel and the aside fallback, and nothing here knows about MudX. In the bottom sheet the summary line lives in the handle;
   in the panel, which has no handle, ShowSummary puts it here as the panel's header (01 section 3.6). The surface is drawn by the contract element
   (css/realm-sheet.css), not by this root. The rows are MemberRow, VehicleRow and PlaceRow, identical in both layouts: their strings come from VmFactory, built
   here once per render from the lists and the session's clock and zone (never the browser's). A tap raises OnSelect with the entity; S8 turns it into the selection.
   S8 also adds the selection header and the detail views. At Peek the list is under the navigation bar and the CSS hides it. *@
@{
    var facts = RowFacts.Create(Members, Places, MeId, Moment, Zone ?? Session?.Zone ?? TimeZoneInfo.Utc);
}
<div class="realm-sheet-content" data-testid="sheet-content">
    @if (ShowSummary)
    {
        <p class="realm-sheet-summary realm-sheet-summary--panel" data-testid="sheet-summary">@Summary</p>
    }

    <SheetSegments Section="Section" Counts="Counts" OnSection="OnSection" />

    <div class="realm-sheet-list-wrap" id="@SheetSegments.PanelId" role="tabpanel" aria-labelledby="@SheetSegments.TabId(Section)">
        <ul class="realm-sheet-list" data-testid="sheet-list">
            @if (Section == Section.Vehicles)
            {
                foreach (var row in VmFactory.VehicleRows(Vehicles, facts))
                {
                    <li @key="row.Id" class="realm-sheet-item">
                        <VehicleRow Row="row" OnClick="() => SelectAsync(EntityKind.Vehicle, row.Id)" />
                    </li>
                }
            }
            else if (Section == Section.Places)
            {
                foreach (var row in VmFactory.PlaceRows(Places, facts))
                {
                    <li @key="row.Id" class="realm-sheet-item">
                        <PlaceRow Row="row" OnClick="() => SelectAsync(EntityKind.Place, row.Id)" />
                    </li>
                }
            }
            else
            {
                foreach (var row in VmFactory.MemberRows(Members, facts))
                {
                    <li @key="row.Id" class="realm-sheet-item">
                        <MemberRow Row="row" OnClick="() => SelectAsync(EntityKind.Member, row.Id)" />
                    </li>
                }
            }
        </ul>
    </div>
</div>

@code {
    /// <summary>The people, in sort order (the Drivers list).</summary>
    [Parameter]
    public IReadOnlyList<MemberVm> Members { get; set; } = [];

    /// <summary>The vehicles, in sort order.</summary>
    [Parameter]
    public IReadOnlyList<VehicleVm> Vehicles { get; set; } = [];

    /// <summary>The places; the list shows them occupied first (01 section 5.3).</summary>
    [Parameter]
    public IReadOnlyList<PlaceVm> Places { get; set; } = [];

    /// <summary>The section that shows.</summary>
    [Parameter]
    public Section Section { get; set; } = Section.Drivers;

    /// <summary>A tab was chosen.</summary>
    [Parameter]
    public EventCallback<Section> OnSection { get; set; }

    /// <summary>A row was tapped: the person, vehicle or place it stands for. The selection is S8's; until then nothing handles it. The chariot placeholder never raises it.</summary>
    [Parameter]
    public EventCallback<EntityRef> OnSelect { get; set; }

    /// <summary>The summary line of 01 section 8.2, shown here only when <see cref="ShowSummary"/> is true.</summary>
    [Parameter]
    public string Summary { get; set; } = string.Empty;

    /// <summary>True in the Expanded panel, which has no handle to carry the summary.</summary>
    [Parameter]
    public bool ShowSummary { get; set; }

    /// <summary>The instant the rows are written at. Default: the session's clock, so Demo's frozen time reaches every string.</summary>
    [Parameter]
    public DateTimeOffset? Now { get; set; }

    /// <summary>The zone clock times are shown in. Default: the session's zone.</summary>
    [Parameter]
    public TimeZoneInfo? Zone { get; set; }

    /// <summary>The viewer's member id (distances on a row are measured from them); null for the first live member, as the map resolves it.</summary>
    [Parameter]
    public string? MeId { get; set; }

    /// <summary>The circuit's session, cascaded by <c>RealmShell</c> (it reaches the popover the sheet is drawn in). Absent in a bare component test.</summary>
    [CascadingParameter]
    public IRealmSession? Session { get; set; }

    private SheetSegments.SegmentCounts Counts => new(Members.Count, Vehicles.Count, Places.Count);

    // The session's own clock, never the wall clock. Only a render with neither an explicit Now nor a session (a bare component test) falls back to the system clock.
    private DateTimeOffset Moment => Now ?? Session?.Time.GetUtcNow() ?? TimeProvider.System.GetUtcNow();

    private Task SelectAsync(EntityKind kind, string id) => OnSelect.InvokeAsync(new EntityRef(kind, id));
}
