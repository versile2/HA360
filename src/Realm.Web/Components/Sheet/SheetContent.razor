@using Realm.Domain

@* The body of the sheet (03 section 3.4): the three-tab control and the list of the section that shows. Container-agnostic: the same markup fills the MudX
   bottom sheet, the MudX left panel and the aside fallback, and nothing here knows about MudX. In the bottom sheet the summary line lives in the handle;
   in the panel, which has no handle, ShowSummary puts it here as the panel's header (01 section 3.6). The surface is drawn by the contract element
   (css/realm-sheet.css), not by this root. S7a builds the list body only: the rows are plain names; S7b replaces them with MemberRow, VehicleRow and
   PlaceRow, and S8 adds the selection header and the detail views. At Peek the list is under the navigation bar and the CSS hides it. *@
<div class="realm-sheet-content" data-testid="sheet-content">
    @if (ShowSummary)
    {
        <p class="realm-sheet-summary realm-sheet-summary--panel" data-testid="sheet-summary">@Summary</p>
    }

    <SheetSegments Section="Section" Counts="Counts" OnSection="OnSection" />

    <div class="realm-sheet-list-wrap" id="@SheetSegments.PanelId" role="tabpanel" aria-labelledby="@SheetSegments.TabId(Section)">
        <ul class="realm-sheet-list" data-testid="sheet-list">
            @foreach (var row in Rows)
            {
                <li @key="row.TestId" class="realm-sheet-row" data-testid="@row.TestId">@row.Name</li>
            }
        </ul>
    </div>
</div>

@code {
    /// <summary>The people, in sort order (the Drivers list).</summary>
    [Parameter]
    public IReadOnlyList<MemberVm> Members { get; set; } = [];

    /// <summary>The vehicles, in sort order.</summary>
    [Parameter]
    public IReadOnlyList<VehicleVm> Vehicles { get; set; } = [];

    /// <summary>The places, in sort order.</summary>
    [Parameter]
    public IReadOnlyList<PlaceVm> Places { get; set; } = [];

    /// <summary>The section that shows.</summary>
    [Parameter]
    public Section Section { get; set; } = Section.Drivers;

    /// <summary>A tab was chosen.</summary>
    [Parameter]
    public EventCallback<Section> OnSection { get; set; }

    /// <summary>The summary line of 01 section 8.2, shown here only when <see cref="ShowSummary"/> is true.</summary>
    [Parameter]
    public string Summary { get; set; } = string.Empty;

    /// <summary>True in the Expanded panel, which has no handle to carry the summary.</summary>
    [Parameter]
    public bool ShowSummary { get; set; }

    private SheetSegments.SegmentCounts Counts => new(Members.Count, Vehicles.Count, Places.Count);

    // The test ids are those of 01 Appendix B (row-member-{id}, row-vehicle-{id}, row-place-{id}), so S7b's real rows keep them.
    private IEnumerable<(string TestId, string Name)> Rows =>
        Section switch
        {
            Section.Vehicles => Vehicles.Select(vehicle => ($"row-vehicle-{vehicle.Id}", vehicle.Name)),
            Section.Places => Places.Select(place => ($"row-place-{place.Id}", place.DisplayName)),
            _ => Members.Select(member => ($"row-member-{member.Id}", member.DisplayName)),
        };
}
