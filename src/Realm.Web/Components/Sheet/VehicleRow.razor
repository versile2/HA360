@using Realm.Domain
@using Realm.Web.Formatting
@using Realm.Web.Sheet

@* One vehicle's row (01 section 5.2; 03 section 3.4): 96 px at the least, three lines (name, location, update). One button like a person's row. The row is positioned by its list item. *@
<button type="button"
        class="@RowClass"
        data-testid="@Row.TestId"
        aria-label="@AriaLabel"
        aria-current="@(Selected ? "true" : null)"
        @onclick="Click">
    <span class="realm-row-avatar-wrap">
        <span class="realm-row-avatar realm-row-avatar--vehicle">
            <MudIcon Icon="@GlyphIcon" Class="realm-row-glyph" />
        </span>
    </span>
    <span class="realm-row-body">
        <span class="realm-row-title">
            <span class="realm-row-name">@Row.Name</span>
            @if (Row.Lore is { } lore)
            {
                <span class="realm-row-lore">@lore</span>
            }
        </span>
        <span class="realm-row-line realm-row-status">@Row.LocationLine</span>
        <span class="@UpdatedClass">
            @if (Row.UpdatedTone == LineTone.Warning)
            {
                <MudIcon Icon="@Icons.Material.Filled.Schedule" Class="realm-row-clock" />
            }
            <span class="realm-row-detail-text">@Row.Updated</span>
        </span>
    </span>
    <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Class="realm-row-chevron" />
</button>

@code {
    // A pickup truck seen from the side, facing right (the same silhouette as the map pin): open bed, cab with a windshield, two wheels. The window is wound the other way round,
    // so the default non-zero fill rule cuts it out of the cab. MudIcon draws this markup in a 24 x 24 box.
    private const string PickupGlyph =
        "<path d=\"M2 9.5h9.5v-3H16l3.3 4H21.2c.44 0 .8.36.8.8V16H2z\"/>"
        + "<path d=\"M13 8v2.2h4.6L15.8 8z\"/>"
        + "<path d=\"M6.2 14.2a2.4 2.4 0 0 1 0 4.8 2.4 2.4 0 0 1 0-4.8z\"/>"
        + "<path d=\"M17.6 14.2a2.4 2.4 0 0 1 0 4.8 2.4 2.4 0 0 1 0-4.8z\"/>";

    /// <summary>The row to draw, from <c>VmFactory.Vehicle</c>.</summary>
    [Parameter, EditorRequired]
    public VehicleRowVm Row { get; set; } = default!;

    /// <summary>The row is the selected one (<c>aria-current</c>).</summary>
    [Parameter]
    public bool Selected { get; set; }

    /// <summary>The vehicle was tapped. The selection itself belongs to the page (S8).</summary>
    [Parameter]
    public EventCallback OnClick { get; set; }

    private string AriaLabel => Row.AccessibleName + " Double tap to show on map.";

    private string GlyphIcon => Row.Glyph == VehicleGlyph.Pickup ? PickupGlyph : Icons.Material.Filled.DirectionsCar;

    private string RowClass => "realm-row realm-row--vehicle" + (Selected ? " realm-row--selected" : string.Empty);

    private string UpdatedClass => "realm-row-line realm-row-detail" + RowClasses.Tone(Row.UpdatedTone);

    private Task Click() => OnClick.InvokeAsync();
}
