@implements IAsyncDisposable
@using Microsoft.JSInterop
@using Realm.Web.Components.Map
@inject IJSRuntime JS
@inject ILogger<HistoryMap> Logger

@* The map of the Location History screen (0.3.0, D123): the element historyMap.js draws into, and nothing else. The day's trail and markers arrive as a payload (HistoryMapPayloads),
   the entry the timeline selected as a focus; a tap on a marker or on a trail comes back through OnPick. The element sits above the timeline in Compact and beside it in Expanded, so it
   is never covered and needs no padding. Like MapView, all script work happens in OnAfterRenderAsync (prerendering renders the element and nothing else), a browser without WebGL 2
   gets a plain message and the timeline keeps working, and the state a test reads is on the element's data-history-* attributes. *@
@if (_unavailable)
{
    <div class="realm-history__map realm-history__map--unavailable" data-testid="history-map-unavailable" role="status">@MapView.WebGlMessage</div>
}
else
{
    <div id="@ContainerId"
         class="realm-history__map"
         data-testid="history-map"
         role="application"
         aria-label="@Label"></div>
}

@code {
    /// <summary>The id of the map's element.</summary>
    public const string ContainerId = "realm-history-map";

    private const string ModulePath = "./js/historyMap.js";

    private IJSObjectReference? _module;
    private DotNetObjectReference<Callbacks>? _callbacks;
    private bool _unavailable;
    private bool _ready;
    private bool _disposed;
    private HistoryDayPayload? _sentDay;
    private HistoryFocusPayload? _sentFocus;

    /// <summary>The day (or range) to draw; null draws nothing.</summary>
    [Parameter]
    public HistoryDayPayload? Day { get; set; }

    /// <summary>The entry to highlight.</summary>
    [Parameter]
    public HistoryFocusPayload? Focus { get; set; }

    /// <summary>A style id of <see cref="MapStyleIds"/>.</summary>
    [Parameter]
    public string StyleId { get; set; } = MapStyleIds.Night;

    /// <summary>The user prefers reduced motion; the script also reads the media query itself.</summary>
    [Parameter]
    public bool ReducedMotion { get; set; }

    /// <summary>The accessible name of the map.</summary>
    [Parameter]
    public string Label { get; set; } = "Map of the day's trail";

    /// <summary>A marker or a trail was tapped: the id of its timeline entry, or the empty string for the empty map.</summary>
    [Parameter]
    public EventCallback<string> OnPick { get; set; }

    /// <summary>The sheet changed size: the map follows.</summary>
    public async Task ResizeAsync()
    {
        if (_module is not null && _ready && !_disposed)
        {
            await SafeAsync(() => _module.InvokeVoidAsync("resize").AsTask());
        }
    }

    /// <summary>Scrolls the timeline list (the element matching <paramref name="selector"/>) to <paramref name="top"/> px, so the entry that was picked on the map is in view.</summary>
    public async Task ScrollListAsync(string selector, double top)
    {
        if (_module is not null && !_disposed)
        {
            await SafeAsync(() => _module.InvokeVoidAsync("scrollListTo", selector, top).AsTask());
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_disposed || _unavailable)
        {
            return;
        }

        if (firstRender)
        {
            await StartAsync();
        }

        await SendAsync();
    }

    private async Task StartAsync()
    {
        try
        {
            _callbacks = DotNetObjectReference.Create(new Callbacks(this));
            _module = await JS.InvokeAsync<IJSObjectReference>("import", ModulePath);
            var strings = MapStrings.Default;
            await _module.InvokeVoidAsync("init", new { containerId = ContainerId, styleId = StyleId, reducedMotion = ReducedMotion, strings = new { mapLabel = Label, attributionLabel = strings.AttributionLabel, demoAttribution = strings.DemoAttribution } }, _callbacks);
            _ready = true;
        }
        catch (Exception exception) when (exception is JSException or JSDisconnectedException or InvalidOperationException or TaskCanceledException)
        {
            // Without the script there is no map: the timeline still works.
            Logger.LogWarning(exception, "The history map could not start.");
        }
    }

    // Sends only what changed since the last send (the payloads are immutable records: a new instance is a change).
    private async Task SendAsync()
    {
        if (_module is null || !_ready || _disposed)
        {
            return;
        }

        if (!ReferenceEquals(_sentDay, Day))
        {
            // A new day forgets the highlight; the same day again (the minute's refresh) keeps it.
            if (!string.Equals(_sentDay?.Key, Day?.Key, StringComparison.Ordinal))
            {
                _sentFocus = new HistoryFocusPayload(null, null);
            }

            _sentDay = Day;
            await SafeAsync(() => _module.InvokeVoidAsync("setDay", Day).AsTask());
        }

        var focus = Focus ?? new HistoryFocusPayload(null, null);
        if (_sentFocus != focus)
        {
            _sentFocus = focus;
            await SafeAsync(() => _module.InvokeVoidAsync("focusEntry", focus).AsTask());
        }
    }

    private static async Task SafeAsync(Func<Task> call)
    {
        try
        {
            await call();
        }
        catch (Exception exception) when (exception is JSDisconnectedException or TaskCanceledException or ObjectDisposedException)
        {
            // The circuit is gone: nothing to draw on.
        }
    }

    private Task PickedAsync(string id) => _disposed ? Task.CompletedTask : InvokeAsync(() => OnPick.InvokeAsync(id));

    private Task WebGlUnavailableAsync()
    {
        if (_disposed)
        {
            return Task.CompletedTask;
        }

        return InvokeAsync(() =>
        {
            _unavailable = true;
            StateHasChanged();
        });
    }

    private void Failed(string area, string message) => Logger.LogWarning("The history map reported a problem in {Area}: {Message}", area, message);

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("dispose");
                await _module.DisposeAsync();
            }
            catch (Exception exception) when (exception is JSDisconnectedException or TaskCanceledException or JSException)
            {
                // The circuit dropped: the browser has already let go of the map.
            }
        }

        _callbacks?.Dispose();
    }

    /// <summary>The <c>[JSInvokable]</c> methods historyMap.js calls, held by one DotNetObjectReference.</summary>
    public sealed class Callbacks
    {
        private readonly HistoryMap _owner;

        internal Callbacks(HistoryMap owner) => _owner = owner;

        [JSInvokable]
        public Task OnReady() => Task.CompletedTask;

        [JSInvokable]
        public Task OnPick(string id) => _owner.PickedAsync(id);

        [JSInvokable]
        public Task OnWebGlUnavailable() => _owner.WebGlUnavailableAsync();

        [JSInvokable]
        public Task OnError(string area, string message)
        {
            _owner.Failed(area, message);
            return Task.CompletedTask;
        }
    }
}
