<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <base href="@BaseHref" />
    <link rel="stylesheet" href="@Assets["_content/MudBlazor/MudBlazor.min.css"]" />
    @* MapLibre's own sheet (markers, the attribution control) loads before ours; realm-map.css loads last so its equal-specificity rules win by order. *@
    <link rel="stylesheet" href="lib/maplibre-gl/maplibre-gl.css" />
    @* CR2-006: MudXProvider injects MudX's stylesheet at runtime and, with no <link data-mudx-css> in the document, would append it AFTER ours, so MudX's rules
       would win every tie. Declaring the link here fixes its place: the provider only rewrites the href of this element (injectCssFromFile). Relative, no @Assets. *@
    <link rel="stylesheet" data-mudx-css="true" href="_content/MudX.MudBlazor.Extension/mudx.min.css" />
    <link rel="stylesheet" href="css/tokens.css" />
    <link rel="stylesheet" href="css/fonts.css" />
    @* The three self-hosted faces (03 section 3.8): relative hrefs resolve under <base>, and crossorigin is required for a font preload to be reused by the @font-face fetch. *@
    <link rel="preload" as="font" type="font/woff2" crossorigin href="fonts/cinzel-latin-wght-normal.woff2" />
    <link rel="preload" as="font" type="font/woff2" crossorigin href="fonts/atkinson-hyperlegible-latin-400-normal.woff2" />
    <link rel="preload" as="font" type="font/woff2" crossorigin href="fonts/atkinson-hyperlegible-latin-700-normal.woff2" />
    <link rel="stylesheet" href="css/app.css" />
    <link rel="stylesheet" href="css/realm-sheet.css" />
    <link rel="stylesheet" href="css/realm-driving.css" />
    <link rel="stylesheet" href="css/realm-map.css" />
    <link rel="stylesheet" href="css/realm-print.css" media="print" />
    <script src="js/theme-boot.js"></script>
    <ImportMap />
    <HeadOutlet @rendermode="InteractiveServer" />
</head>

<body>
    <div id="components-reconnect-modal" class="realm-reconnect" role="status" data-testid="banner-reconnect" hidden>
        <span class="realm-reconnect-text"></span>
        <button type="button" class="realm-reconnect-retry" hidden>Try again</button>
    </div>
    @* Blazor's own error UI (BootErrors.ts). An unhandled exception ends the circuit and the reconnect banner never shows for it, so this static
       element is the only way out: Blazor shows it with style.display = "block" and wires the click of every ".reload" inside it to location.reload(). *@
    <div id="blazor-error-ui" role="alert" hidden>
        <p class="realm-error-text">Something went sideways in the castle. Try again.</p>
        <button type="button" class="reload realm-error-reload">Reload</button>
    </div>
    <Routes @rendermode="InteractiveServer" ViewerMemberId="@_viewerMemberId" />
    <script src="@Assets["_content/MudBlazor/MudBlazor.min.js"]"></script>
    <script src="@Assets["_framework/blazor.web.js"]" autostart="false"></script>
    <script src="js/reconnect-banner.js"></script>
    <script src="js/blazor-start.js"></script>
</body>

</html>

@code {
    /// <summary>The Ingress header that carries the Home Assistant user id (02 section 2.5). Only the SSR request reads it, and only to resolve "me".</summary>
    private const string UserIdHeader = "X-Remote-User-Id";

    private string? _viewerMemberId;

    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    [Inject]
    private Realm.Domain.IViewerResolver Viewers { get; set; } = default!;

    // The ingress prefix with one trailing slash ("" becomes "/"); every URL in the page resolves against it (03 section 5.4).
    private string BaseHref => (HttpContext?.Request.PathBase.Value ?? string.Empty) + "/";

    // "Me", resolved once per page load in static SSR (03 section 5.5, R-082, D38). The Home Assistant user id is a local of this method: it goes into the resolver and nowhere else, so
    // it is never a field, a component parameter, a marker or a log line, and only the member slug (for example "king") is handed to Routes.
    protected override void OnInitialized()
    {
        var haUserId = HttpContext?.Request.Headers[UserIdHeader].FirstOrDefault();
        _viewerMemberId = Viewers.Resolve(haUserId).MemberId;
    }
}
