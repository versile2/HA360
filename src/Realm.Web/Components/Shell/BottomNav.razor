@implements IDisposable
@using Microsoft.JSInterop
@using Realm.Web.State
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject IDialogService Dialogs
@inject RealmUiState Ui
@inject HistorySync History

@* The two tabs and Settings (01 section 2.2; D105). Settings is a button, not a route: it opens the Settings dialog (S10a, 03 section 3.4, 01 section 7.9) with the standard dialog service, so Esc, the scrim and
   the dialog's own back arrow close it and MudBlazor returns the focus to this button. Location or Driving stays the current tab (aria-current) while the dialog is open. The two tabs (01 section 2.2). The links stay real anchors, so a click before the circuit has connected still navigates; once the circuit is up the handler below takes the click
   (preventDefault) and runs the rules of the table: a tab change releases the history entries of the page it leaves and navigates with a REPLACE, and a re-tap of the tab you are on is
   a "home" gesture (Location: Peek and nothing selected; Driving: back to the top and This week). A modifier click is not told apart: Blazor's preventDefault is fixed per render. *@
<nav class="realm-nav" aria-label="Main">
    <a class="realm-nav-link" href="./" data-testid="nav-location" aria-current="@(OnLocation ? "page" : null)" @onclick="OnLocationTapAsync" @onclick:preventDefault="true">
        <MudIcon Icon="@(OnLocation ? Icons.Material.Filled.LocationOn : Icons.Material.Outlined.LocationOn)" />
        <span class="realm-nav-label">Location</span>
    </a>
    <a class="realm-nav-link" href="driving" data-testid="nav-driving" aria-current="@(OnDriving ? "page" : null)" @onclick="OnDrivingTapAsync" @onclick:preventDefault="true">
        <MudIcon Icon="@(OnDriving ? Icons.Material.Filled.DirectionsCar : Icons.Material.Outlined.DirectionsCar)" />
        <span class="realm-nav-label">Driving</span>
    </a>
    <button type="button" class="realm-nav-link realm-nav-button" data-testid="btn-settings" aria-haspopup="dialog" @onclick="OpenSettingsAsync">
        <MudIcon Icon="@Icons.Material.Outlined.Settings" />
        <span class="realm-nav-label">Settings</span>
    </button>
</nav>

@code {
    private static readonly char[] QueryOrFragment = ['?', '#'];

    // The scrim is the Realm's own (realm-driving.css); the dialog draws its own back arrow, so MudBlazor's close button is off. Full-screen below 600 px is CSS (realm-map.css).
    private static readonly DialogOptions SettingsOptions = new()
    {
        CloseOnEscapeKey = true,
        BackdropClick = true,
        CloseButton = false,
        BackgroundClass = "realm-popup-scrim",
    };

    private async Task OpenSettingsAsync() => await Dialogs.ShowAsync<SettingsDialog>(null, SettingsOptions);

    // The path below the base URI, without a query or fragment: "" on Location, "driving" and "driving/{member}" on the Driving routes.
    private string CurrentPath
    {
        get
        {
            var relative = Navigation.ToBaseRelativePath(Navigation.Uri);
            var end = relative.IndexOfAny(QueryOrFragment);
            return end < 0 ? relative : relative[..end];
        }
    }

    private bool OnLocation => CurrentPath.Length == 0;

    private bool OnDriving => CurrentPath is "driving" || CurrentPath.StartsWith("driving/", StringComparison.Ordinal);

    protected override void OnInitialized() => Navigation.LocationChanged += OnLocationChanged;

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) => _ = InvokeAsync(StateHasChanged);

    // Location: on Location the tab is a home gesture, the sheet to Peek and the selection cleared (the reducer's NavReTap, which the history then follows by itself); from anywhere else it
    // is a tab change.
    private Task OnLocationTapAsync() =>
        OnLocation ? ReTapLocationAsync() : ChangeTabAsync("./");

    // Driving: on a Driving route the tab scrolls the page to the top and selects This week; from anywhere else it is a tab change.
    private Task OnDrivingTapAsync() =>
        OnDriving ? ReTapDrivingAsync() : ChangeTabAsync("driving");

    private Task ReTapLocationAsync()
    {
        Ui.Apply(new SheetEvent.NavReTap());
        return Task.CompletedTask;
    }

    private async Task ReTapDrivingAsync()
    {
        Ui.SelectedWeek = 0;
        try
        {
            await JS.InvokeVoidAsync("scrollTo", 0, 0);
        }
        catch (JSDisconnectedException)
        {
            // The circuit dropped; there is no page left to scroll.
        }

        // This week is the default and leaves no ?week= parameter (the chips write it the same way), nor a ?period= with its dates (a long period); a replace, so Back from Driving still leaves for Location.
        var thisWeek = Navigation.GetUriWithQueryParameters(new Dictionary<string, object?>(StringComparer.Ordinal)
        {
            ["week"] = null,
            ["period"] = null,
            ["from"] = null,
            ["to"] = null,
        });
        if (!string.Equals(thisWeek, Navigation.Uri, StringComparison.Ordinal))
        {
            Navigation.NavigateTo(thisWeek, replace: true);
        }
    }

    // A tab change replaces the history entry (01 section 2.2). The entries the page above pushed (the sheet's depth tokens, the Driving sentinel) are taken back first, and awaited, so that
    // none stays between the new page and the entry it replaces.
    private async Task ChangeTabAsync(string relativeUri)
    {
        await History.ReleaseAsync();
        Navigation.NavigateTo(relativeUri, replace: true);
    }

    public void Dispose() => Navigation.LocationChanged -= OnLocationChanged;
}
