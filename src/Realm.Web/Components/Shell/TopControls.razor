@inject IDialogService Dialogs

@* The floating controls that every page shows. The gear opens the Settings dialog (S10a, 03 section 3.4, 01 section 7.9) with the standard dialog service, so Esc, the scrim and
   the dialog's own back arrow close it and MudBlazor returns the focus to the gear. *@
<MudIconButton Icon="@Icons.Material.Filled.Settings"
               Class="realm-gear"
               aria-label="Settings"
               aria-haspopup="dialog"
               data-testid="btn-settings"
               OnClick="OpenSettingsAsync" />

@code {
    // The scrim is the Realm's own (realm-driving.css); the dialog draws its own back arrow, so MudBlazor's close button is off. Full-screen below 600 px is CSS (realm-map.css).
    private static readonly DialogOptions SettingsOptions = new()
    {
        CloseOnEscapeKey = true,
        BackdropClick = true,
        CloseButton = false,
        BackgroundClass = "realm-popup-scrim",
    };

    private async Task OpenSettingsAsync() => await Dialogs.ShowAsync<SettingsDialog>(null, SettingsOptions);
}
